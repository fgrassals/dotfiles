#!/usr/bin/env bash
# wlsunset night light toggle
set -euo pipefail

case "${1:?usage: nightlight toggle}" in
    toggle)
        if pgrep -x wlsunset >/dev/null; then
            pkill -x wlsunset
        else
            wlsunset -t 3500 -T 3501 -S 00:00 -s 23:59 &>/dev/null &
        fi
        ;;
    *)
        echo "usage: nightlight toggle" >&2
        exit 1
        ;;
esac
